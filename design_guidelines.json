  "implementation_plan": {
    "phases": [
      {
        "name": "Setup & Theming",
        "steps": [
          "Install 'Space Grotesk' and 'Outfit' fonts via Google Fonts in index.html.",
          "Update tailwind.config.js with the new color palette (slate-900 primary, blue-600 secondary).",
          "Set global CSS defaults: body font 'Outfit', headings 'Space Grotesk'."
        ]
      },
      {
        "name": "Core Components",
        "steps": [
          "Create 'CreditCard' component: A visual representation of a credit card using CSS gradients (Gold, Platinum, Black).",
          "Create 'FeatureCard' component: Floating white card with icon and large text.",
          "Create 'ComparisonTable' component: Sticky header, clear row separation, check/cross icons."
        ]
      },
      {
        "name": "Pages",
        "steps": [
          "Home: Hero with split layout (Text Left, Image Right). Quick filter bar floating over the hero bottom.",
          "Card Listing: Sidebar filters (desktop) or Drawer (mobile). Grid of cards.",
          "Comparison: Side-by-side view. Highlight differences."
        ]
      }
    ]
  },
  "universal_guidelines": [
    "Use 2-3x more spacing than typical designs. Use p-8 or p-12.",
    "Do NOT use gradients for text. Use solid, high-contrast colors.",
    "Every interaction needs micro-animations (hover states, scale).",
    "Currency must be formatted as INR (₹). Example: ₹1,500.",
    "Mobile-first: Images max-h-[50vh] on mobile.",
    "Use 'sonner' for toast notifications.",
    "Components must use named exports.",
    "All interactive elements must have data-testid attributes."
  ],
  "anti_patterns": [
    "No Inter font.",
    "No purple/teal gradients (unless specific card art).",
    "No centered text for long paragraphs.",
    "No generic 'Bootstrap' column layouts. Use asymmetric grids."
  ]
}